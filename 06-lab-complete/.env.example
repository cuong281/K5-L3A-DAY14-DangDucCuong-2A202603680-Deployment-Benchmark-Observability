# cp .env.example .env rồi điền giá trị. Không commit file .env.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bắt buộc khi ENVIRONMENT=production. Tạo key: openssl rand -hex 32
AGENT_API_KEY=

REDIS_URL=redis://localhost:6379/0

# Số request tối đa mỗi API key trong 60 giây
RATE_LIMIT_PER_MINUTE=10

# Vượt một trong hai mức thì trả 402 (giờ UTC)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
